#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in
    /*) ;;
    ?:[/\\]*) ;;
    *) SOURCE="$DIR/$SOURCE" ;;
  esac
done
HERE="$(cd -P "$(dirname "$SOURCE")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"
# shellcheck disable=SC1091
. "$ROOT/lib/log.sh"
# shellcheck disable=SC1091
. "$ROOT/lib/docker.sh"
# shellcheck disable=SC1091
. "$ROOT/lib/doctor.sh"

cmd="${1:-help}"; shift || true

usage() {
  cat <<'EOF'
Usage: devenv <command> [flags]

Commands:
  up [flags]               run the bootstrap orchestrator
  doctor                   cross-platform environment health + each module's doctor
  services up [profiles..] bring up baseline + named profiles (default if none)
  services down            stop all services
  services status          list running services + readiness (nonzero exit if any not ready)
  services logs <svc>      tail a service's logs
  services init <svc> <p>  create per-project DB / bucket / index in shared instance
  services nuke --yes      stop services AND wipe all volumes
  help                     this help

Not yet implemented: update, repos.
EOF
}

cmd_up()     { exec bash "$ROOT/bootstrap.sh" "$@"; }
cmd_doctor() {
  local env_rc=0 mod_rc=0
  printf 'Environment\n'
  devenv_doctor_env || env_rc=1
  printf '\nModules\n'
  for d in "$ROOT"/modules/*/; do
    name="$(basename "${d%/}")"
    if [ -x "$d/doctor.sh" ]; then
      out="$("$d/doctor.sh" 2>&1)" && printf '%s\n' "[OK]   $name $out" || { printf '%s\n' "[FAIL] $name $out"; mod_rc=1; }
    else
      printf '%s\n' "[--]   $name (no doctor)"
    fi
  done
  [ "$env_rc" -eq 0 ] && [ "$mod_rc" -eq 0 ]
}

_compose() {
  # shellcheck disable=SC2046
  docker compose $(devenv_compose_args) "$@"
}

_all_profile_flags="--profile default --profile aws --profile search --profile vectors --profile queues --profile analytics --profile observability --profile alt-db --profile auth"

_compose_all() {
  # shellcheck disable=SC2086
  _compose $_all_profile_flags "$@"
}

# Render a SERVICE/STATE/READY table from `docker compose ps --format json`.
# READY = Docker health when a healthcheck exists, else `no-probe` when running,
# else the raw non-running state.
cmd_services_status() {
  local json rc_docker=0
  json="$(_compose_all ps --format json)" || rc_docker=$?
  if [ "$rc_docker" -ne 0 ]; then
    log_err "docker compose ps failed (exit $rc_docker)"
    return "$rc_docker"
  fi
  if [ -z "$json" ]; then
    log_info "No services running."
    return 0
  fi
  printf '%-20s %-12s %-10s\n' SERVICE STATE READY
  local svc state health ready rc=0
  while IFS=$'\t' read -r svc state health; do
    [ -z "$svc" ] && continue
    if [ -n "$health" ]; then
      ready="$health"
    elif [ "$state" = "running" ]; then
      ready="no-probe"
    else
      ready="$state"
    fi
    case "$ready" in
      healthy|no-probe) ;;
      *) rc=1 ;;
    esac
    printf '%-20s %-12s %-10s\n' "$svc" "$state" "$ready"
  done < <(printf '%s\n' "$json" | jq -r '[.Service, .State, (.Health // "")] | @tsv')
  return "$rc"
}

cmd_services() {
  local sub="${1:-help}"; shift || true
  case "$sub" in
    up)
      local profiles=("$@")
      [ "${#profiles[@]}" -eq 0 ] && profiles=(default)
      local flags=()
      local p; for p in "${profiles[@]}"; do flags+=(--profile "$p"); done
      _compose "${flags[@]}" up -d
      ;;
    down)   _compose_all down ;;
    status) cmd_services_status ;;
    logs)
      [ -n "${1:-}" ] || { log_err "services logs <service>"; return 2; }
      _compose logs -f "$1"
      ;;
    init)
      [ -n "${1:-}" ] && [ -n "${2:-}" ] || { log_err "services init <svc> <project>"; return 2; }
      local svc="$1" proj="$2"
      local db; db="$(devenv_db_for_project "$proj")"
      case "$svc" in
        postgres) _compose exec -T postgres psql -U dev -d dev -c "CREATE DATABASE $db;" ;;
        mysql)    _compose exec -T mysql mysql -u root -pdev -e "CREATE DATABASE IF NOT EXISTS $db;" ;;
        minio)    _compose exec -T minio sh -c "mc alias set local http://localhost:9000 dev devsecret >/dev/null && mc mb -p local/${proj}-dev" ;;
        opensearch) _compose exec -T opensearch curl -fsS -X PUT "http://localhost:9200/$db" ;;
        *) log_err "init: unsupported service '$svc' (supported: postgres, mysql, minio, opensearch)"; return 2 ;;
      esac
      ;;
    nuke)
      [ "${1:-}" = "--yes" ] || { log_err 'services nuke requires --yes'; return 2; }
      _compose_all down -v
      log_info "All devenv volumes wiped."
      ;;
    help|-h|--help|'') usage ;;
    *) log_err "services: unknown subcommand '$sub'"; return 2 ;;
  esac
}

case "$cmd" in
  up)             cmd_up "$@" ;;
  doctor)         cmd_doctor ;;
  services)       cmd_services "$@" ;;
  help|-h|--help) usage ;;
  update|repos)   log_err "$cmd: not implemented yet"; exit 2 ;;
  *)              log_err "Unknown command: $cmd"; usage; exit 2 ;;
esac
